KB_DOCUMENTS = [
    {
        "doc_id": "DOC1",
        "title": "Return Windows Policy",
        "text": "Apparel and Footwear products are eligible for return within 10 days of delivery. Electronics and Home appliances have a 7-day return window. Beauty products are strictly non-returnable once opened.",
    },
    {
        "doc_id": "DOC2",
        "title": "COD Refund Timelines",
        "text": "For Cash on Delivery (COD) orders, refunds are processed via IMPS bank transfer within 3 to 5 business days after pickup verification. Customers must provide their UPI ID or bank account details in the portal.",
    },
    {
        "doc_id": "DOC3",
        "title": "Delivery SLAs",
        "text": "Standard delivery SLA across tier-1 cities is 2 to 3 business days. Tier-2 and tier-3 locations may take 5 to 7 business days. Express delivery guarantees next-day fulfillment for eligible sellers.",
    },
    {
        "doc_id": "DOC4",
        "title": "Reverse-Pickup Eligibility",
        "text": "Reverse pickup is available for 95% of pincodes. Items must be unused, unwashed, and in original packaging with intact tags. If reverse pickup is unavailable, customers must self-ship for doorstep reimbursement.",
    },
]


def build_vector_store():
    embedder = SentenceTransformer("all-MiniLM-L6-v2")
    chunks = []
    chunk_mapping = []

    for doc in KB_DOCUMENTS:
        sentences = [s.strip() + "." for s in doc["text"].split(".") if s]
        for sentence in sentences:
            chunks.append(sentence)
            chunk_mapping.append(doc["doc_id"])

    embeddings = embedder.encode(chunks, convert_to_numpy=True)
    return embedder, chunks, chunk_mapping, embeddings


EMBEDDER, CHUNKS, CHUNK_MAPPING, CHUNK_EMBEDDINGS = build_vector_store()


def retrieve_policy(query: str, top_k: int = 3):
    query_vec = EMBEDDER.encode([query], convert_to_numpy=True)
    scores = np.dot(CHUNK_EMBEDDINGS, query_vec.T).squeeze()
    top_indices = np.argsort(scores)[::-1][:top_k]

    results = []
    for idx in top_indices:
        results.append(
            {
                "chunk": CHUNKS[idx],
                "doc_id": CHUNK_MAPPING[idx],
                "score": float(scores[idx]),
            }
        )
    return results


# -------------------------------------------------------------------------
# 2. INTEGRATED TOOLS (Tasks 3 & 4)
# -------------------------------------------------------------------------


def check_return_risk(order_features: dict) -> dict:
    model_data = joblib.load("models/return_risk_model.pkl")
    pipeline = model_data["pipeline"]
    t_star_rf = model_data["t_star_rf"]

    import pandas as pd

    df_in = pd.DataFrame([order_features])

    prob = float(pipeline.predict_proba(df_in)[0, 1])

    if prob < t_star_rf:
        bucket = "Low"
    elif prob >= (t_star_rf + 0.15):
        bucket = "High"
    else:
        bucket = "Medium"

    return {"predicted_probability": prob, "risk_bucket": bucket, "t_star": t_star_rf}


def classify_product_image(image_path: str) -> dict:
    CLASS_NAMES = [
        "T-shirt/top",
        "Trouser",
        "Pullover",
        "Dress",
        "Coat",
        "Sandal",
        "Shirt",
        "Sneaker",
        "Bag",
        "Ankle boot",
    ]

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = models.resnet18()
    model.fc = nn.Linear(model.fc.in_features, 10)
    model.load_state_dict(
        torch.load("models/product_classifier.pt", map_location=device)
    )
    model.eval()

    transform = transforms.Compose(
        [
            transforms.Lambda(lambda img: img.convert("RGB")),
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(
                mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]
            ),
        ]
    )

    img = Image.open(image_path)
    tensor = transform(img).unsqueeze(0).to(device)

    with torch.no_grad():
        outputs = model(tensor)
        probs = torch.softmax(outputs, dim=1)[0]
        conf, pred = torch.max(probs, dim=0)

    return {
        "predicted_category": CLASS_NAMES[pred.item()],
        "confidence": float(conf.item()),
    }


