import os
import joblib
import numpy as np
import pandas as pd
from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.compose import ColumnTransformer
from sklearn.dummy import DummyClassifier
from sklearn.ensemble import RandomForestClassifier
from sklearn.impute import SimpleImputer
from sklearn.inspection import permutation_importance
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report, f1_score, precision_score, recall_score, roc_auc_score
from sklearn.model_selection import GridSearchCV, StratifiedKFold, train_test_split
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler


class PrevReturnRatioAdder(BaseEstimator, TransformerMixin):
    """Custom transformer to add domain feature without data leakage."""

    def fit(self, X, y=None):
        return self

    def transform(self, X):
        X_out = X.copy()
        orders = np.maximum(X_out["num_previous_orders"].values, 1)
        returns = X_out["num_previous_returns"].values
        has_orders = (X_out["num_previous_orders"].values > 0).astype(float)
        X_out["prev_return_ratio"] = np.where(
            has_orders, returns / orders, 0.0
        )
        return X_out


def run_part1():
    os.makedirs("models", exist_ok=True)

    # 1. Load Data & Task 2 Verification
    df = pd.read_csv("data/orders_dataset.csv")
    print("--- TASK 2: DATA VERIFICATION ---")
    print(f"Total Rows: {len(df)}, Total Columns: {df.shape[1]}")
    overall_return_rate = df["returned"].mean()
    missing_rating_pct = df["rating_given"].isna().mean()
    print(f"Overall Return Rate: {overall_return_rate:.4%}")
    print(f"Missing rating_given %: {missing_rating_pct:.4%}")

    print("\nReturn Rate by Product Category:")
    print(df.groupby("product_category")["returned"].mean())
    print("\nReturn Rate by Payment Method:")
    print(df.groupby("payment_method")["returned"].mean())

    cod_missing = df[df["payment_method"] == "COD"]["rating_given"].isna().mean()
    non_cod_missing = (
        df[df["payment_method"] != "COD"]["rating_given"].isna().mean()
    )
    print(
        f"\nMissingness Gap: COD missing rate = {cod_missing:.2%}, Non-COD missing rate = {non_cod_missing:.2%}"
    )
    print(
        "Missingness Pattern: MAR (Missing At Random). The missingness of rating_given depends on the observed variable payment_method (higher for COD)."
    )

    # 3. Preprocessing Setup & Train/Test Split
    X = df.drop(columns=["order_id", "returned"])
    y = df["returned"]

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=42, stratify=y
    )

    num_cols = [
        "price_inr",
        "discount_pct",
        "customer_tenure_days",
        "num_previous_orders",
        "num_previous_returns",
        "delivery_distance_km",
        "delivery_days",
        "is_weekend_order",
        "rating_given",
        "prev_return_ratio",
    ]
    cat_cols = ["product_category", "payment_method"]

    num_pipeline = Pipeline(
        [
            ("imputer", SimpleImputer(strategy="median")),
            ("scaler", StandardScaler()),
        ]
    )

    cat_pipeline = Pipeline(
        [
            ("imputer", SimpleImputer(strategy="most_frequent")),
            ("ohe", OneHotEncoder(drop="first", handle_unknown="ignore")),
        ]
    )

    preprocessor = ColumnTransformer(
        transformers=[
            ("num", num_pipeline, num_cols),
            ("cat", cat_pipeline, cat_cols),
        ]
    )

    # 4. Task 4: Baseline Model
    print("\n--- TASK 4: DUMMY BASELINE ---")
    dummy = DummyClassifier(strategy="most_frequent")
    dummy.fit(X_train, y_train)
    dummy_preds = dummy.predict(X_test)
    dummy_acc = dummy.score(X_test, y_test)
    dummy_f1 = f1_score(y_test, dummy_preds, pos_label=1, zero_division=0)
    print(f"Dummy Accuracy: {dummy_acc:.4f} | Class 1 F1: {dummy_f1:.4f}")

    # 5. Task 5: Logistic Regression Tuning
    print("\n--- TASK 5: LOGISTIC REGRESSION ---")
    lr_pipe = Pipeline(
        [
            ("feature_engineer", PrevReturnRatioAdder()),
            ("preprocessor", preprocessor),
            (
                "clf",
                LogisticRegression(class_weight="balanced", random_state=42),
            ),
        ]
    )
    lr_pipe.fit(X_train, y_train)
    lr_probs = lr_pipe.predict_proba(X_test)[:, 1]

    print(
        f"Default Threshold (0.5) ROC-AUC: {roc_auc_score(y_test, lr_probs):.4f}"
    )
    print(
        f"Default Threshold (0.5) F1: {f1_score(y_test, (lr_probs >= 0.5).astype(int)):.4f}"
    )

    thresholds = np.arange(0.10, 0.92, 0.02)
    best_lr_f1, best_lr_t = 0.0, 0.5
    for t in thresholds:
        preds = (lr_probs >= t).astype(int)
        score = f1_score(y_test, preds, zero_division=0)
        if score > best_lr_f1:
            best_lr_f1 = score
            best_lr_t = t

    lr_opt_preds = (lr_probs >= best_lr_t).astype(int)
    print(
        f"Optimal Threshold: {best_lr_t:.2f} | Max F1: {best_lr_f1:.4f} | Recall: {recall_score(y_test, lr_opt_preds):.4f} | Precision: {precision_score(y_test, lr_opt_preds):.4f}"
    )

    # 6. Task 6: Random Forest Tuning
    print("\n--- TASK 6: RANDOM FOREST GRIDSEARCH ---")
    rf_pipe = Pipeline(
        [
            ("feature_engineer", PrevReturnRatioAdder()),
            ("preprocessor", preprocessor),
            (
                "clf",
                RandomForestClassifier(
                    class_weight="balanced", random_state=42
                ),
            ),
        ]
    )

    param_grid = {
        "clf__n_estimators": [100, 200],
        "clf__max_depth": [6, 10, None],
    }

    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    grid_search = GridSearchCV(
        rf_pipe, param_grid, cv=cv, scoring="roc_auc", n_jobs=-1
    )
    grid_search.fit(X_train, y_train)

    best_rf = grid_search.best_estimator_
    print(f"Best RF Params: {grid_search.best_params_}")
    print(f"Best Cross-Validated ROC-AUC: {grid_search.best_score_:.4f}")

    rf_probs = best_rf.predict_proba(X_test)[:, 1]
    test_auc = roc_auc_score(y_test, rf_probs)
    print(f"Held-out Test-set ROC-AUC: {test_auc:.4f}")

    # 7. Task 7: Feature Importance vs Permutation Importance
    print("\n--- TASK 7: FEATURE IMPORTANCE ANALYSIS ---")
    cat_ohe_names = (
        best_rf.named_steps["preprocessor"]
        .named_transformers_["cat"]
        .named_steps["ohe"]
        .get_feature_names_out(cat_cols)
        .tolist()
    )
    feature_names = num_cols + cat_ohe_names

    rf_model = best_rf.named_steps["clf"]
    impurity_importances = pd.Series(
        rf_model.feature_importances_, index=feature_names
    ).sort_values(ascending=False)
    print("Top 5 Impurity-based Feature Importances:")
    print(impurity_importances.head(5))

    perm_imp = permutation_importance(
        best_rf, X_test, y_test, scoring="roc_auc", n_repeats=10, random_state=42
    )
    perm_importances = pd.Series(
        perm_imp.importances_mean, index=X_test.columns
    ).sort_values(ascending=False)
    print("\nPermutation Importances (Original Features):")
    print(perm_importances.head(5))

    # 8. Task 8: Subgroup Analysis
    print("\n--- TASK 8: SUBGROUP ANALYSIS ---")
    test_df = X_test.copy()
    test_df["returned"] = y_test
    test_df["pred_prob"] = rf_probs
    test_df["pred_label"] = (rf_probs >= 0.50).astype(int)

    print("\nBy Product Category:")
    for cat, group in test_df.groupby("product_category"):
        rec = recall_score(group["returned"], group["pred_label"])
        prec = precision_score(
            group["returned"], group["pred_label"], zero_division=0
        )
        print(f"Category: {cat:12s} | Recall: {rec:.4f} | Precision: {prec:.4f}")

    # 9. Task 9: Threshold Calibration & Artifact Export
    print("\n--- TASK 9: SAVE MODEL & CALIBRATE THRESHOLD ---")
    best_rf_f1, t_star_rf = 0.0, 0.5
    for t in thresholds:
        preds = (rf_probs >= t).astype(int)
        score = f1_score(y_test, preds, zero_division=0)
        if score > best_rf_f1:
            best_rf_f1 = score
            t_star_rf = t

    print(
        f"Random Forest Optimal Threshold (t*_rf): {t_star_rf:.2f} | Max F1: {best_rf_f1:.4f}"
    )

    artifact = {"pipeline": best_rf, "t_star_rf": t_star_rf}
    joblib.dump(artifact, "models/return_risk_model.pkl")
    print("Saved return risk model artifact to models/return_risk_model.pkl")


if __name__ == "__main__":
    run_part1()
